# Neon — connection string de base de datos. Copia este archivo a .env.local
# y rellena el valor real. Solo se usa en el servidor (Route Handlers), nunca
# debe llevar el prefijo NEXT_PUBLIC_.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require
